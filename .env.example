# ==============================================================================
# Real-Time Facial Expression Detection Web Application - Environment Variables
# Copy this file to `.env.local` for local development
# ==============================================================================

# Supabase Public API Configuration (Safe for client browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Secret Admin Key (Server-side only; NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Application Base URL (Used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
